<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">https://sandesh.com</domain>
        <domain includeSubdomains="true">https://mapi.sandesh.com</domain>
    </domain-config>
    <!-- Optional: Allow cleartext traffic for development environment (localhost, etc.) -->
    <domain-config cleartextTrafficPermitted="true">
       <domain includeSubdomains="true">localhost</domain>
       <domain includeSubdomains="true">10.0.2.2</domain>
       <!-- Add other local IPs if needed -->
    </domain-config>
</network-security-config>
